<resources>
    <string name="app_name">Basira</string>

    <!-- Status titles and recovery details. Spoken as "title. detail". -->
    <string name="status_initializing_title">Starting</string>
    <string name="status_initializing_detail">Checking the glasses, the internet and the English voice.</string>
    <string name="status_meta_ai_missing_title">Meta AI app is not installed</string>
    <string name="status_meta_ai_missing_detail">Meta AI is required to pair the glasses, connect this app and allow the camera. Use the Install Meta AI button.</string>
    <string name="status_bluetooth_title">Nearby devices permission needed</string>
    <string name="status_bluetooth_detail">Allow nearby devices so the app can reach your glasses.</string>
    <string name="status_registration_title">Connect this app to Meta AI</string>
    <string name="status_registration_detail">Press Connect to Meta AI. Meta AI opens. Approve the connection, then return here.</string>
    <string name="status_registering_title">Connecting to Meta AI</string>
    <string name="status_registering_detail">Finish the steps in Meta AI, then come back.</string>
    <string name="status_glasses_unavailable_title">No glasses found</string>
    <string name="status_glasses_unavailable_detail">Pair your Ray-Ban Meta glasses in the Meta AI app, turn them on and keep them close to the phone.</string>
    <string name="status_glasses_disconnected_title">Glasses disconnected</string>
    <string name="status_glasses_disconnected_detail">Turn the glasses on, unfold them and put them on. The app reconnects automatically.</string>
    <string name="status_permission_required_title">Camera permission needed</string>
    <string name="status_permission_required_detail">Press Allow camera. Meta AI will ask you to let this app use the glasses camera.</string>
    <string name="status_permission_denied_title">Camera permission denied</string>
    <string name="status_permission_denied_detail">The app cannot see without camera access. Press Allow camera to ask again.</string>
    <string name="status_update_firmware_title">Glasses update required</string>
    <string name="status_update_firmware_detail">Open Meta AI and update the glasses software, then try again.</string>
    <string name="status_update_glasses_app_title">Glasses app update required</string>
    <string name="status_update_glasses_app_detail">Press Update glasses app. Meta AI opens the update screen.</string>
    <string name="status_update_this_app_title">This app needs an update</string>
    <string name="status_update_this_app_detail">This version is no longer compatible with your glasses. Install the latest version of Basira.</string>
    <string name="status_tts_missing_title">No speech engine</string>
    <string name="status_tts_missing_detail">Install a text to speech app that supports English, such as Speech Services by Google, then return to this app.</string>
    <string name="status_voice_missing_title">English voice not installed</string>
    <string name="status_voice_missing_detail">Press Install English voice and download the English voice data. The app does not speak in another language instead.</string>
    <string name="status_offline_title">No internet connection</string>
    <string name="status_offline_detail">Descriptions need the internet. Connect to Wi-Fi or mobile data.</string>
    <string name="status_ready_title">Ready</string>
    <string name="status_ready_detail">Press Describe what is in front of me.</string>
    <string name="status_connection_restored_title">Connection restored</string>
    <string name="status_connection_restored_detail">Press Describe again to get a fresh description. Nothing was sent automatically.</string>
    <string name="status_glasses_connected_title">Glasses connected</string>
    <string name="status_listening_title">Listening</string>
    <string name="status_listening_detail">Say a command, for example: describe, read text, or find my keys.</string>
    <string name="status_capturing_title">Taking a photo</string>
    <string name="status_capturing_detail">Keep your head still.</string>
    <string name="status_uploading_title">Sending the photo</string>
    <string name="status_uploading_detail">Please wait.</string>
    <string name="status_analyzing_title">Analyzing the photo</string>
    <string name="status_analyzing_detail">Please wait.</string>
    <string name="status_speaking_title">Speaking the description</string>
    <string name="status_speaking_detail">Press Stop speaking to interrupt.</string>
    <string name="status_loaded_title">Description ready</string>
    <string name="status_loaded_detail">Press Repeat last description to hear it again.</string>
    <string name="status_empty_title">Nothing recognized</string>
    <string name="status_empty_detail">Try again with better light, or turn your head toward what you want described.</string>
    <string name="status_currency_uncertain_title">Denomination not certain</string>
    <string name="status_currency_uncertain_detail">I could not identify the banknote with enough confidence. Hold it flat and closer, in good light, and try again.</string>
    <string name="status_timeout_title">The request timed out</string>
    <string name="status_timeout_detail">Press Try again.</string>
    <string name="status_rate_limited_title">Too many requests</string>
    <string name="status_rate_limited_detail">Please wait a moment before trying again.</string>
    <string name="status_auth_expired_title">Service session expired</string>
    <string name="status_auth_expired_detail">Press Try again to reconnect to the description service.</string>
    <string name="status_invalid_image_title">The photo could not be used</string>
    <string name="status_invalid_image_detail">Press Try again.</string>
    <string name="status_invalid_response_title">The service sent an invalid answer</string>
    <string name="status_invalid_response_detail">Nothing was spoken, to avoid wrong information. Press Try again.</string>
    <string name="status_error_title">Something went wrong</string>
    <string name="status_error_detail">Press Try again.</string>
    <string name="status_error_capture_failed">The glasses could not take a photo. Press Try again.</string>
    <string name="status_error_capture_busy">The glasses camera is busy. Wait a moment and try again.</string>
    <string name="status_error_thermal">The glasses are too hot. Let them cool down, then try again.</string>
    <string name="status_error_battery">The glasses battery is low. Charge the glasses.</string>
    <string name="status_error_folded">The glasses are folded. Unfold them and try again.</string>
    <string name="status_error_server">The description service has a problem. Press Try again later.</string>
    <string name="status_error_transport">There is a connection problem. Press Try again.</string>
    <string name="status_error_quota">The daily usage limit of the description service was reached. Try again later.</string>
    <string name="status_error_blocked">The service declined to describe this photo. Turn your head a little and try again.</string>
    <string name="status_error_missing_target">Type or say the name of the object first.</string>
    <string name="status_fatal_title">Service unavailable</string>
    <string name="status_fatal_detail">The app cannot continue. Restart the app or contact support.</string>
    <string name="status_fatal_forbidden">This phone is not allowed to use the description service. Contact support.</string>
    <string name="status_fatal_not_configured">The description service is not set up in this test build. Ask the person who gave you the app for a new build.</string>
    <string name="status_fatal_key_rejected">The description service refused this build. Ask the person who gave you the app for a new build.</string>

