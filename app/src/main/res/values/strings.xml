    <string name="onboarding_welcome_title">Welcome to Basira</string>
    <string name="onboarding_welcome_body">Basira describes your surroundings using the camera of your Ray-Ban Meta glasses and speaks in the app language, English or Arabic, which you can change in Settings. This setup works with TalkBack and takes a few minutes.</string>
    <string name="onboarding_consent_title">Privacy and safety</string>
    <string name="consent_point_capture">The glasses camera captures your surroundings when you ask for a description.</string>
    <string name="consent_point_people">Photos may include other people and private information.</string>
    <string name="consent_point_provider">Each photo is sent directly from this phone to Google Gemini for analysis.</string>
    <string name="consent_point_storage">Photos are not stored on your phone unless you turn that on in settings.</string>
    <string name="consent_point_accuracy">AI descriptions can be wrong, incomplete or late.</string>
    <string name="consent_point_not_replacement">This app does not replace a white cane, a guide dog, mobility training or help from people.</string>
    <string name="consent_point_safety">Never rely on it alone to cross a road, identify medicine or make emergency decisions.</string>
    <string name="consent_accept">I understand and agree</string>
    <string name="consent_decline">Exit</string>
    <string name="onboarding_setup_title">Connect your glasses</string>
    <string name="onboarding_setup_body">Meta AI must stay installed. It pairs the glasses, connects this app, allows the camera, updates the glasses and, during the developer preview, enables Developer Mode.</string>
