# ---------------------------------------------------------------------------
# Secrets and machine-local configuration (never commit)
# ---------------------------------------------------------------------------
# Holds sdk.dir and the Gemini API key (GEMINI_API_KEY / GEMINI_MODEL).
local.properties
# Signing material
*.jks
*.keystore
*.p12
*.pem
keystore.properties
signing.properties
# Environment / credential files
.env
.env.*
*.secret
secrets.properties
google-services.json
service-account*.json

# ---------------------------------------------------------------------------
# Gradle / Kotlin build output and caches
# ---------------------------------------------------------------------------
.gradle/
.kotlin/
build/
out/
captures/
.externalNativeBuild/
.cxx/
*.hprof
# Keep the Gradle wrapper jar committed
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Android artifacts
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
# Proguard / R8 mapping files (regenerated per build)
mapping.txt
# Lint/test reports outside build/
lint-results*.html
lint-results*.xml

# ---------------------------------------------------------------------------
# IDE (Android Studio / IntelliJ / VS Code / Fleet)
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.navigation/
.vscode/
.fleet/

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.swp
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
